import { experimental_AstroContainer as AstroContainer } from 'astro/container';
import { expect, test } from 'vitest';
import IndexPage from '../src/pages/index.astro';
import { getContainerRenderer as getReactRenderer } from '@astrojs/react';

test('Index page renders TopNavBar, Hero, Features, Pricing, and Footer', async () => {
    const container = await AstroContainer.create({
        renderers: [
            getReactRenderer()
        ]
    });
    
    const result = await container.renderToString(IndexPage);

    // Assert Navbar
    expect(result).toContain('IPTV Ledger');
    expect(result).toContain('Revendeurs');

    // Assert Hero Component rendered
    expect(result).toContain('Dominez le Marché IPTV');
    expect(result).toContain('Lancer mon panel');

    // Assert Features Component rendered
    expect(result).toContain('Fonctionnalités Clés');
    expect(result).toContain("Panneau d'Administration Unifié");

    // Assert Pricing Component rendered (React Component Hydration Check)
    expect(result).toContain('Simulateur de Rentabilité');
    expect(result).toContain('Profit Mensuel Estimé'); 
    expect(result).toContain('Prix de revente moyen (Mensuel)');
    
    // Assert Footer rendered
    expect(result).toContain('Tous droits réservés');
    
    // Assert Semantic Tags
    expect(result).toMatch(/<main[^>]*>/);
    expect(result).toMatch(/<\/main>/);
    expect(result).toMatch(/<section[^>]*>/);
    expect(result).toMatch(/<article[^>]*>/);
    
    // Check exactly one <h1>
    const h1Matches = result.match(/<h1[^>]*>/gi);
    expect(h1Matches).not.toBeNull();
    expect(h1Matches?.length).toBe(1);
});
