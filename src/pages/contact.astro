---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LeadForm from '../components/LeadForm.astro';
import { whatsAppHref } from '../config/contact';
import { pageMeta } from '../config/pages';

const meta = pageMeta['/contact'];
const generalWhatsApp = whatsAppHref('Hello, I have a GetIPTVPanel enquiry.');
const supportWhatsApp = whatsAppHref('Hello, I need GetIPTVPanel support. My account reference and issue are:');
const breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }];
---

<Layout title={meta.title} description={meta.description} breadcrumbs={breadcrumbs}>
  <Breadcrumbs items={breadcrumbs} />
  <div class="page-hero-dark-wrap">
    <PageHero eyebrow="Clear enquiry routes" title="Contact the Right Team with the Right Context" intro="Use the reseller form for package and panel enquiries. Use support for an existing account or setup problem. Never send passwords, payment-card details or a full credential string." />
  </div>
  <section class="section section-shell" aria-labelledby="contact-route-title">
    <div class="section-split">
      <SectionHeading id="contact-route-title" eyebrow="Direct contact" title="Choose the route that matches your question" intro="A concise, well-routed message is easier to act on than the same enquiry sent through every channel." />
      <div class="contact-routes">
        <article><span>01</span><div><h3>Reseller pricing</h3><p>Share expected scale, budget and experience through the qualified form.</p><a href="#reseller-enquiry">Open reseller form →</a></div></article>
        <article><span>02</span><div><h3>General enquiry</h3><p>Start a direct WhatsApp conversation for commercial terms or another question.</p><a href={generalWhatsApp} data-event="whatsapp_click" rel="noopener noreferrer">Open WhatsApp →</a></div></article>
        <article><span>03</span><div><h3>Account support</h3><p>Prepare your account reference, device, player version, time and exact error.</p><a href={supportWhatsApp} data-event="whatsapp_click" rel="noopener noreferrer">Message support →</a></div></article>
      </div>
    </div>
  </section>
  <section id="reseller-enquiry" class="section application-section">
    <div class="section-shell application-layout">
      <aside class="application-aside"><SectionHeading eyebrow="Reseller enquiry" title="Request panel access or package terms" intro="Include your intended market, a realistic 90-day range and the contact method you can answer." /></aside>
      <LeadForm origin="contact-page" />
    </div>
  </section>
</Layout>
