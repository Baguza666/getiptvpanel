---
import Layout from '../layouts/Layout.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro'; import PageHero from '../components/PageHero.astro'; import { pageMeta } from '../config/pages'; import { site } from '../config/site';
const meta = pageMeta['/acceptable-use']; const breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'Acceptable use', path: '/acceptable-use' }];
---
<Layout title={meta.title} description={meta.description} breadcrumbs={breadcrumbs}><Breadcrumbs items={breadcrumbs} /><PageHero eyebrow="Responsible operation" title="Acceptable Use Policy" intro="GetIPTVPanel enquiry, panel and support routes must not be used to facilitate infringement, evade enforcement, abuse systems or mishandle customer data." /><section class="section surface-section"><div class="section-shell prose"><div class="meta-row"><span>Updated {site.updatedDate}</span></div><h2>Prohibited activity</h2><ul><li>Distributing content without the required rights or permission.</li><li>Using protected broadcaster, league, platform or programme branding without authorisation.</li><li>Providing or requesting instructions to evade enforcement, app-store controls or network restrictions.</li><li>Uploading, linking to or distributing unofficial application packages.</li><li>Sharing stolen, purchased or third-party account credentials.</li><li>Submitting payment-card data, passwords or unnecessary personal data through support channels.</li><li>Automated form abuse, probing, denial-of-service activity, injection attempts or circumvention of access controls.</li><li>Misrepresenting package capabilities, prices, availability, performance or earnings.</li></ul><h2>Reseller responsibility</h2><p>A reseller must verify lawful supply in each intended territory, market offers accurately, protect customer data, keep an appropriate support process and comply with the applicable commercial and consumer obligations.</p><h2>Response to misuse</h2><p>Suspected misuse may lead to enquiry rejection, access restriction, evidence preservation or referral to an appropriate provider or authority where legally required.</p></div></section></Layout>
