---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import HeroProfitCalculator from '../components/HeroProfitCalculator.astro';
import ServerLogoList from '../components/ServerLogoList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { whatsAppHref } from '../config/contact';
import { pageMeta } from '../config/pages';
import { resellerPackages } from '../config/plans';

const meta = pageMeta['/'];
const resellerWhatsApp = whatsAppHref('Hello, I would like to request a written quote for reseller panel credits.');
const formatGbp = (amount: number) => new Intl.NumberFormat('en-GB', {
  style: 'currency',
  currency: 'GBP',
  maximumFractionDigits: 0,
}).format(amount);

const workflow = [
  { title: 'Compare the panel options', text: 'Review the available panels, their unit rates and the verified controls included with each option.' },
  { title: 'Prepare your operating details', text: 'Tell us your target market, initial order size, current reseller experience and the panel features you need.' },
  { title: 'Receive the complete terms', text: 'Confirm the panel name, credit rate, minimum order, account duration, support route, payment details and applicable commercial conditions in writing.' },
  { title: 'Test your customer workflow', text: 'Before scaling, test account creation, customer setup, renewal handling and support escalation with a small controlled process.' },
];

const panelFeatures = [
  { title: 'Customer account management', text: 'Create and renew eligible accounts, record a customer reference and check the account status from the panel.' },
  { title: 'Credit tracking', text: 'See the credits available to your reseller account and understand the credit cost before taking a customer order.' },
  { title: 'Expiry and renewal workflow', text: 'Keep expiry dates visible so customers can be contacted before an eligible account ends.' },
  { title: 'Support context', text: 'Record the minimum non-sensitive information needed to investigate an account issue. Never store or send complete customer credentials in analytics or public messages.' },
];

const personas = [
  { title: 'New resellers', text: 'Start with a clear minimum order, a written quote and a support process you can explain to customers.' },
  { title: 'Existing resellers', text: 'Compare panel rates and workflows before moving or expanding eligible customer accounts.' },
  { title: 'Agencies and device installers', text: 'Evaluate whether the panel fits an existing customer-service operation without mixing customer credentials into marketing or analytics systems.' },
];

const groupedRates = [...new Set(resellerPackages.map((plan) => plan.pricePerCredit))].map((rate) => ({
  rate,
  plans: resellerPackages.filter((plan) => plan.pricePerCredit === rate),
}));
---

<Layout title={meta.title} description={meta.description} mobileCta={{ href: resellerWhatsApp, label: 'Request a written quote', event: 'whatsapp_click' }}>
  <div class="page-hero-dark-wrap">
    <PageHero
      eyebrow="UK reseller panel and onboarding"
      title="IPTV Reseller Panel for UK Reseller Businesses"
      intro="Manage customer activations, renewals and credit balances from one reseller panel. Compare the available panel options, review the published credit rates and request the complete commercial terms before you place an order."
      primaryHref="/reseller-packages/"
      primaryLabel="Compare reseller packages"
      secondaryHref="/reseller-panel/"
      secondaryLabel="See how the panel works"
    >
      <HeroProfitCalculator />
    </PageHero>
    <div class="hero-metrics section-shell" aria-label="Core reseller terms">
      <div class="hero-metric"><span>Minimum order</span><strong>10 credits</strong></div>
      <div class="hero-metric"><span>Credit duration</span><strong>12 months</strong></div>
      <div class="hero-metric"><span>Per-credit rates</span><strong>£12 / £18 / £24</strong></div>
      <div class="hero-metric"><span>Added panel fees</span><strong>None</strong></div>
    </div>
  </div>

  <section class="surface-section" aria-label="Verified site commitments">
    <div class="trust-strip section-shell">
      <div class="trust-item">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.3"><path d="m5 12 4 4L19 6"></path></svg>
        <span>10-credit minimum</span>
      </div>
      <div class="trust-item">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.3"><path d="m5 12 4 4L19 6"></path></svg>
        <span>One credit activates one 12-month account</span>
      </div>
      <div class="trust-item">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.3"><path d="m5 12 4 4L19 6"></path></svg>
        <span>Written terms before payment</span>
      </div>
    </div>
  </section>

  <section class="section surface-section" aria-labelledby="panel-features-title">
    <div class="section-shell section-split">
      <div>
        <SectionHeading
          id="panel-features-title"
          eyebrow="Panel workflow"
          title="Run the account work from one place"
          intro="A reseller operation becomes difficult to manage when customer references, expiry dates, renewals and credit use are scattered across chats and spreadsheets. The reseller panel gives you one operating view for the account lifecycle. Use it to create or renew eligible customer accounts, monitor your available credits and keep the information needed for support organised."
        />
        <p class="notice-subtle">Only publish capabilities that are present in the selected panel. Panel access does not grant distribution rights for third-party content.</p>
        <a href="/reseller-panel/" class="button button-secondary section-action" data-event="panel_demo_open">View the reseller-panel workflow</a>
      </div>
      <div class="feature-stack">
        {panelFeatures.map((feature, index) => (
          <article class="feature-row">
            <span>0{index + 1}</span>
            <div><h3>{feature.title}</h3><p>{feature.text}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-shell" aria-labelledby="package-preview-title">
    <SectionHeading
      id="package-preview-title"
      eyebrow="Reseller packages"
      title="Compare the published credit rates"
      intro="There are seven configured panel options across the published rates of £12, £18 and £24 per credit. Every order starts at a minimum of 10 credits. One credit activates one 12-month account under the applicable panel terms. For an order of exactly 20 credits, the total is the unit rate multiplied by 20. Larger orders may receive a different written quote. No separate panel or setup fee is added to the published credit price. Any applicable tax, payment cost, renewal condition or refund rule must be confirmed in the written quote before payment."
    />
    <div class="rate-grid">
      {groupedRates.map((group) => (
        <article class="rate-card">
          <p class="rate-label">Published GBP rate</p>
          <p class="rate-value">£{group.rate} <span>per credit</span></p>
          <div class="rate-totals">
            <div><span>10-credit minimum</span><strong>{formatGbp(group.rate * 10)}</strong></div>
            <div><span>20 credits</span><strong>{formatGbp(group.rate * 20)}</strong></div>
          </div>
          <ServerLogoList plans={group.plans} />
          <p class="rate-card-copy">For orders above 20 credits, contact us for the current lower written volume quote.</p>
          <a href={whatsAppHref(`Hello, I would like to request the written terms for £${group.rate}-per-credit reseller panels.`)} class="button button-primary" data-event="whatsapp_click" data-placement="homepage-packages">Ask about £{group.rate} panels</a>
        </article>
      ))}
    </div>
    <div class="notice section-action">
      <a href="/reseller-packages/" class="button button-secondary">Compare rates and terms</a>
    </div>
  </section>

  <section class="section section-shell" aria-labelledby="workflow-title">
    <div class="section-split">
      <div>
        <SectionHeading id="workflow-title" eyebrow="A controlled route to launch" title="How the reseller process works" intro="Follow a practical step-by-step process from initial comparison to customer onboarding." />
        <a href="/become-a-reseller/" class="button button-primary section-action">Prepare a reseller application</a>
      </div>
      <div class="workflow-line">
        {workflow.map((item, index) => (
          <article>
            <span class="step-number">0{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section dark-section" aria-labelledby="calculator-preview-title">
    <div class="section-shell">
      <div class="calculator-promo">
        <div>
          <p class="eyebrow">Business estimate</p>
          <h2 id="calculator-preview-title">Estimate the numbers before buying credits</h2>
          <p>Use the GBP calculator to model revenue, credit cost, payment fees, refund allowance, customer acquisition cost and other operating expenses. The result is an estimate, not a promise. It helps you see the break-even point and the effect of unsold credits before you choose an order size.</p>
          <a href="/profit-calculator/" class="button button-primary section-action" data-event="profit_calculator_start" data-placement="homepage-preview">Open the reseller calculator</a>
        </div>
        <div class="calculator-preview-metrics" aria-label="Calculator inputs and outputs">
          <div><span>Package cost</span><strong>Your quote</strong></div>
          <div><span>Customer price</span><strong>Your input</strong></div>
          <div><span>Operating costs</span><strong>Your inputs</strong></div>
          <div><span>Break-even</span><strong>Calculated</strong></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-shell" aria-labelledby="who-this-is-for-title">
    <SectionHeading id="who-this-is-for-title" eyebrow="Audience suitability" title="Who this is for" intro="Designed for operators who require structured customer management and clear commercial terms." />
    <div class="rate-grid">
      {personas.map((persona) => (
        <article class="rate-card">
          <h3>{persona.title}</h3>
          <p>{persona.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section surface-section" aria-labelledby="b2c-bridge-title">
    <div class="section-shell section-split">
      <div>
        <SectionHeading id="b2c-bridge-title" eyebrow="Secondary route" title="Only need one subscription?" intro="The main offer is a reseller panel. When an individual UK package is verified and available, the individual page will show the supported territory, devices, price, renewal and refund terms." />
        <a href="/individual-subscription/" class="button button-secondary section-action">Check individual availability</a>
      </div>
    </div>
  </section>

  <section class="section section-shell" aria-labelledby="faq-title">
    <div class="section-split">
      <SectionHeading id="faq-title" eyebrow="Reseller FAQ" title="Frequently asked questions" />
      <div class="faq-list">
        <details><summary>What does one reseller credit activate?</summary><p>One credit activates one 12-month account under the applicable panel terms. Confirm the exact account scope and any restrictions in the written quote.</p></details>
        <details><summary>What is the minimum reseller order?</summary><p>The published minimum is 10 credits. A different quote may apply to larger orders.</p></details>
        <details><summary>Does panel access include content distribution rights?</summary><p>No. Buying panel access or credits does not grant rights to distribute third-party programmes, channels, films, sports or other protected content. The operator remains responsible for holding the permissions required in every territory served.</p></details>
        <details><summary>Are earnings guaranteed?</summary><p>No. Revenue, margin and customer retention depend on your selling price, operating costs, lawful offer, support quality and demand. The calculator is an estimate only.</p></details>
        <details><summary>How do I choose between the panel options?</summary><p>Compare the verified features, rate, minimum order, customer workflow, support route and complete written terms. Do not choose on unit price alone.</p></details>
      </div>
    </div>
  </section>

  <section class="section-tight section-shell" aria-labelledby="final-cta-title">
    <div class="cta-panel">
      <p class="eyebrow">Next step</p>
      <h2 id="final-cta-title">Compare the reseller options with the terms visible</h2>
      <p>Review the rates first, then request a written quote for the panel and order size you intend to use.</p>
      <div class="hero-actions centered-actions">
        <a href="/reseller-packages/" class="button button-primary">Compare reseller packages</a>
        <a href={resellerWhatsApp} class="button button-secondary" data-event="whatsapp_click" data-placement="final-cta">Request a written quote</a>
      </div>
    </div>
  </section>
</Layout>
