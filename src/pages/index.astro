      </div>

      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-7 gap-3">
        {
          [
            { id: "f1", name: "Formula 1" }, { id: "viaplay", name: "Viaplay" }, { id: "rtl", name: "RTL" }, { id: "hbomax", name: "HBO Max" }, { id: "sbs6", name: "SBS6" }, { id: "motogp", name: "MotoGP" }, { id: "paramount", name: "Paramount" },
            { id: "laune", name: "La Une" }, { id: "ufc", name: "UFC" }, { id: "rtltvi", name: "RTL TVI" }, { id: "tf1", name: "TF1" }, { id: "vtm", name: "VTM" }, { id: "france2", name: "France 2" }, { id: "play4", name: "Play4" },
            { id: "sbs", name: "SBS" }, { id: "zes", name: "ZES" }, { id: "tlc", name: "TLC" }, { id: "bfmtv", name: "BFM TV" }, { id: "nlziet", name: "NLZIET" }, { id: "disney", name: "Disney+" }, { id: "hulu", name: "Hulu" },
            { id: "discovery", name: "Discovery" }, { id: "eurosport", name: "Eurosport" }, { id: "vrt", name: "VRT" }, { id: "espn", name: "ESPN" }, { id: "film1", name: "Film1" }, { id: "veronica", name: "Veronica" }, { id: "ziggo", name: "Ziggo Sport" },
            { id: "discoveryplus", name: "Discovery+" }, { id: "sbs9", name: "SBS9" }, { id: "bbc", name: "BBC" }, { id: "fox", name: "FOX" }, { id: "cnn", name: "CNN" }, { id: "hbomax-alt", name: "HBO Max" }, { id: "tv4", name: "TV4" },
            { id: "cmore", name: "C More" }, { id: "aftonbladet", name: "Aftonbladet" }, { id: "teliaplay", name: "Telia Play" }, { id: "eurosport-alt", name: "Eurosport" }, { id: "npoplus", name: "NPO Plus" }, { id: "tvl", name: "TVL" }, { id: "kanaalz", name: "Kanaal Z" }
          ].map((channel) => (
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 flex items-center justify-center hover:bg-white/10 hover:border-white/20 transition-all duration-300 group aspect-[2/1] relative overflow-hidden">
              {/* Fallback Text: shows only if the image fails or isn't uploaded yet */}
              <span class="absolute text-xs font-bold text-gray-500 opacity-60 group-hover:opacity-100 transition-opacity z-0 text-center px-1">{channel.name}</span>
              
              {/* Main Logo Image */}
              <img
                src={`/channels/${channel.id}.webp`}
                alt={`Logo ${channel.name}`}
                width="80"
                height="40"
                loading="lazy"
                onerror="this.style.display='none'"
                class="w-full h-full max-w-[80px] object-contain opacity-70 group-hover:opacity-100 transition-all duration-300 drop-shadow-md z-10 relative bg-transparent"
              />
            </div>
          ))
        }
      </div>
    </section>

    <!-- OTT Servers Section -->
    <section class="relative py-20 px-4 max-w-7xl mx-auto text-center">
      <!-- Ambient glow -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="w-[600px] h-[400px] rounded-full bg-indigo-500/10 blur-[100px]"></div>
      </div>

      <div class="relative z-10">
        <!-- Brand badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-sm text-indigo-400 font-medium mb-6">
          <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
