          </ul>
          <a href="https://wa.me/212782389820?text=Bonjour%2C%20je%20souhaite%20commander%20le%20Pack%20Pro%20%28600%E2%82%AC%29%20pour%20devenir%20revendeur." target="_blank" rel="noopener noreferrer" class="w-full bg-coral hover:bg-coral/90 text-white py-3 rounded-lg font-bold transition block text-center">Devenir Pro</a>
        </article>

        <!-- VIP -->
