          <a href="#tarifs" title="Devenir revendeur Serveur IPTV Crystal" class="px-6 py-3 rounded-full bg-white/5 border border-white/10 text-white font-medium hover:bg-indigo-500/20 hover:border-indigo-400 transition-all duration-300">Crystal</a>
          <a href="#tarifs" title="Devenir revendeur Serveur IPTV Dino" class="px-6 py-3 rounded-full bg-white/5 border border-white/10 text-white font-medium hover:bg-indigo-500/20 hover:border-indigo-400 transition-all duration-300">Dino</a>
          <a href="#tarifs" title="Devenir revendeur Serveur IPTV Sansat" class="px-6 py-3 rounded-full bg-white/5 border border-white/10 text-white font-medium hover:bg-indigo-500/20 hover:border-indigo-400 transition-all duration-300">Sansat</a>
          <a href="#tarifs" title="Devenir revendeur Serveur IPTV Lion" class="px-6 py-3 rounded-full bg-white/5 border border-white/10 text-white font-medium hover:bg-indigo-500/20 hover:border-indigo-400 transition-all duration-300">Lion</a>
          <a href="#tarifs" title="Devenir revendeur Serveur IPTV Mega" class="px-6 py-3 rounded-full bg-white/5 border border-white/10 text-white font-medium hover:bg-indigo-500/20 hover:border-indigo-400 transition-all duration-300">Mega</a>
          <a href="#tarifs" title="Devenir revendeur Serveur IPTV Python" class="px-6 py-3 rounded-full bg-white/5 border border-white/10 text-white font-medium hover:bg-indigo-500/20 hover:border-indigo-400 transition-all duration-300">Python</a>
          <a href="#tarifs" title="Devenir revendeur Serveur IPTV Dream" class="px-6 py-3 rounded-full bg-white/5 border border-white/10 text-white font-medium hover:bg-indigo-500/20 hover:border-indigo-400 transition-all duration-300">Dream</a>
          <a href="#tarifs" title="Devenir revendeur Serveur IPTV Eagle" class="px-6 py-3 rounded-full bg-white/5 border border-white/10 text-white font-medium hover:bg-indigo-500/20 hover:border-indigo-400 transition-all duration-300">Eagle</a>
          <a href="#tarifs" title="Devenir revendeur Serveur IPTV Max OTT" class="px-6 py-3 rounded-full bg-white/5 border border-white/10 text-white font-medium hover:bg-indigo-500/20 hover:border-indigo-400 transition-all duration-300">Max OTT</a>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section id="tarifs" class="py-20 px-4 max-w-7xl mx-auto">
