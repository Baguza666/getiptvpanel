---
import Layout from '../layouts/Layout.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro'; import PageHero from '../components/PageHero.astro'; import { pageMeta } from '../config/pages'; import { site } from '../config/site';
const meta = pageMeta['/terms']; const breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'Terms', path: '/terms' }];
---
<Layout title={meta.title} description={meta.description} breadcrumbs={breadcrumbs}><Breadcrumbs items={breadcrumbs} /><PageHero eyebrow="Website use" title="Website Terms" intro="These terms govern use of the public information and enquiry routes. They are not a substitute for a reseller package agreement." /><section class="section surface-section"><div class="section-shell prose"><div class="meta-row"><span>Updated {site.updatedDate}</span></div><h2>Published panel prices</h2><p>The displayed £12, £18 and £24 credit prices are the full panel prices for orders from 10 through 20 credits. No tax, setup fee or separate panel fee is added. Orders above 20 credits receive a lower price through WhatsApp.</p><h2>Information, not a commercial guarantee</h2><p>The panel demonstration, calculator, guides and checklists are general information. Calculator results depend on user inputs and do not guarantee income or profit.</p><h2>Permitted website use</h2><p>You may browse the site and submit genuine enquiries. You must not probe or disrupt the service, automate abusive submissions, impersonate another person, submit malicious material or use the site to promote copyright infringement.</p><h2>Rights and lawful supply</h2><p>Nothing on the website grants rights to third-party programmes, broadcasts, films, brands or applications. Buyers and resellers must verify the distribution and territory rights for a specific offer.</p><h2>External services</h2><p>Links to official app stores, GOV.UK and WhatsApp lead to third-party services governed by their own terms and privacy practices.</p></div></section></Layout>
