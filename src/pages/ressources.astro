---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
import SeoMesh from '../components/SeoMesh.astro';
---
<Layout title="Ressources & Outils pour Revendeur IPTV" description="Toutes les ressources, tutoriels et applications nécessaires pour développer votre activité de revendeur IPTV et assister vos clients.">
  <SEO 
    title="Ressources & Guides IPTV" 
    description="Découvrez nos guides, tutoriels et stratégies pour réussir votre business de revendeur IPTV." 
  />
  <main class="pt-32 pb-20 px-4 max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold font-['Clash_Display'] mb-6 text-white tracking-tight">Ressources & Guides pour Revendeurs</h1>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        Maîtrisez les infrastructures technologiques et les stratégies marketing pour scaler votre base clients.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
      <!-- Card 1 -->
      <a href="/comment-trouver-clients-iptv/" class="glass block p-8 rounded-2xl border border-white/10 hover:bg-white/10 transition group">
        <h3 class="text-xl font-bold text-white mb-3 font-['Clash_Display'] group-hover:text-indigo-400 transition-colors">Trouver des Clients</h3>
        <p class="text-gray-400">Stratégies TikTok, Telegram et réseau local pour acquérir vos premiers abonnés.</p>
      </a>

      <!-- Card 2 -->
      <a href="/rentabilite-revendeur-iptv/" class="glass block p-8 rounded-2xl border border-white/10 hover:bg-white/10 transition group">
        <h3 class="text-xl font-bold text-white mb-3 font-['Clash_Display'] group-hover:text-coral transition-colors">Rentabilité du Modèle</h3>
        <p class="text-gray-400">Calculez vos marges et structurez vos prix de revente pour générer du profit.</p>
      </a>

      <!-- Card 3 -->
      <a href="/meilleur-panel-revendeur-iptv/" class="glass block p-8 rounded-2xl border border-white/10 hover:bg-white/10 transition group">
        <h3 class="text-xl font-bold text-white mb-3 font-['Clash_Display'] group-hover:text-emerald transition-colors">Le Meilleur Panel</h3>
        <p class="text-gray-400">Comparatif d'infrastructure et avantages de la gestion Anti-FAI dynamique.</p>
      </a>

      <!-- Card 4 -->
      <a href="/eviter-coupures-iptv/" class="glass block p-8 rounded-2xl border border-white/10 hover:bg-white/10 transition group">
        <h3 class="text-xl font-bold text-white mb-3 font-['Clash_Display'] group-hover:text-indigo-400 transition-colors">Éviter les Coupures</h3>
        <p class="text-gray-400">Comprendre le throttling et contourner virtuellement les blocages des FAI français.</p>
      </a>

      <!-- Card 5 -->
      <a href="/configurer-iptv-smarters-pro/" class="glass block p-8 rounded-2xl border border-white/10 hover:bg-white/10 transition group">
        <h3 class="text-xl font-bold text-white mb-3 font-['Clash_Display'] group-hover:text-coral transition-colors">Smarters Pro</h3>
        <p class="text-gray-400">Le guide de configuration étape par étape utilisant l'API Xtream Codes.</p>
      </a>

      <!-- Card 6 -->
      <a href="/installer-tivimate-premium/" class="glass block p-8 rounded-2xl border border-white/10 hover:bg-white/10 transition group">
        <h3 class="text-xl font-bold text-white mb-3 font-['Clash_Display'] group-hover:text-emerald transition-colors">TiviMate Premium</h3>
        <p class="text-gray-400">Tutoriel d'installation optimal pour les configurations Android TV et Firestick.</p>
      </a>
    </div>

    <!-- Internal Link Mesh -->
    <SeoMesh />
  </main>
</Layout>
