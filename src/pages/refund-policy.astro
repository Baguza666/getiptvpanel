---
import Layout from '../layouts/Layout.astro'; import Breadcrumbs from '../components/Breadcrumbs.astro'; import PageHero from '../components/PageHero.astro'; import { pageMeta } from '../config/pages'; import { site } from '../config/site';
const meta = pageMeta['/refund-policy']; const breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'Refund policy', path: '/refund-policy' }];
---
<Layout title={meta.title} description={meta.description} breadcrumbs={breadcrumbs}><Breadcrumbs items={breadcrumbs} /><PageHero eyebrow="Commercial terms" title="Refund Policy" intro="GetIPTVPanel does not take payment through this website. Pricing conversations and reseller applications continue through WhatsApp." /><section class="section surface-section"><div class="section-shell prose"><div class="meta-row"><span>Updated {site.updatedDate}</span></div><h2>No website checkout</h2><p>Because this website does not process a payment, there is no website transaction to refund. The displayed panel price has no tax, setup fee or separate panel fee added to it.</p><h2>Review the order before paying</h2><p>Confirm the selected panel, credit quantity, total price and delivery details in the WhatsApp conversation before making a payment.</p><h2>Mandatory rights</h2><p>Nothing on this page limits rights that apply under UK law.</p></div></section></Layout>
