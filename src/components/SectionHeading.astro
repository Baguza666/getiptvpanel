---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'centre';
}

const { id, eyebrow, title, intro, align = 'left' } = Astro.props;
---

<div class:list={['section-heading', align === 'centre' && 'section-heading-centre']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{title}</h2>
  {intro && <p>{intro}</p>}
</div>
