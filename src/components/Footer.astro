---
const currentYear = new Date().getFullYear();
---
<footer class="bg-[#111116] border-t border-white/10 mt-20 relative z-10">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 text-center md:text-left">
      
      <!-- Col 1: Brand & Copyright -->
      <div class="flex flex-col justify-center md:justify-start">
        <a href="/" aria-label="Accueil GetIPTVPanel" class="inline-block mb-4">
          <img src="/getiptvlogo.png" alt="GetIPTVPanel Logo" class="h-12 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity" width="200" height="48" />
        </a>
        <p class="text-gray-400 text-sm mt-auto">
          &copy; {currentYear} GetIPTVPanel.<br/>Tous droits réservés.
        </p>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="flex flex-col items-center md:items-start">
        <h4 class="text-white font-bold mb-4 font-['Clash_Display'] tracking-wide">Navigation</h4>
        <nav class="flex flex-col gap-2 text-sm text-gray-400">
          <a href="/" class="hover:text-white transition-colors">Accueil</a>
          <a href="/guide-panel-revendeur" class="hover:text-white transition-colors">Guide Revendeur</a>
          <a href="/meilleur-fournisseur-iptv" class="hover:text-white transition-colors">Notre Infrastructure</a>
          <a href="/contact" class="hover:text-white transition-colors">Contact</a>
        </nav>
      </div>

      <!-- Col 3: Ressources Links -->
      <div class="flex flex-col items-center md:items-start">
        <h4 class="text-white font-bold mb-4 font-['Clash_Display'] tracking-wide">Ressources</h4>
        <nav class="flex flex-col gap-2 text-sm text-gray-400">
          <a href="/ressources" class="hover:text-white transition-colors text-indigo-400 font-medium">Centre de Ressources</a>
          <a href="/comment-trouver-clients-iptv" class="hover:text-white transition-colors">Trouver des Clients</a>
          <a href="/rentabilite-revendeur-iptv" class="hover:text-white transition-colors">Calculer sa Rentabilité</a>
          <a href="/meilleur-panel-revendeur-iptv" class="hover:text-white transition-colors">Le Meilleur Panel 2026</a>
        </nav>
      </div>

      <!-- Col 4: Legal Links -->
      <div class="flex flex-col items-center md:items-start">
        <h4 class="text-white font-bold mb-4 font-['Clash_Display'] tracking-wide">Légal</h4>
        <nav class="flex flex-col gap-2 text-sm text-gray-400">
          <a href="/mentions-legales" class="hover:text-white transition-colors">Mentions Légales</a>
          <a href="/cgv" class="hover:text-white transition-colors">CGV (Conditions Générales de Vente)</a>
        </nav>
      </div>

    </div>
  </div>
</footer>
