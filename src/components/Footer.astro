---
import { whatsAppHref } from '../config/contact';
import { site } from '../config/site';
import Brand from './Brand.astro';

const currentYear = new Date().getFullYear();
const resellerWhatsApp = whatsAppHref('Hello, I would like the current reseller pricing and panel terms.');
const commercial = [
  { href: '/reseller-panel', label: 'Reseller panel' },
  { href: '/reseller-packages', label: 'Reseller packages' },
  { href: '/become-a-reseller', label: 'Become a reseller' },
  { href: '/profit-calculator', label: 'Profit calculator' },
];
const company = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/support', label: 'Support' },
  { href: '/guides', label: 'Guides' },
  { href: '/is-iptv-legal-in-the-uk', label: 'UK legality guide' },
];
const legal = [
  { href: '/privacy-policy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
  { href: '/refund-policy', label: 'Refund policy' },
  { href: '/acceptable-use', label: 'Acceptable use' },
];
---

<footer class="site-footer">
  <div class="footer-cta section-shell">
    <div>
      <p class="eyebrow">Build with the numbers visible</p>
      <h2>Start with a panel rate you can model.</h2>
    </div>
    <a href={resellerWhatsApp} class="button button-primary" data-event="whatsapp_click" data-placement="footer" rel="noopener noreferrer">Request pricing on WhatsApp</a>
  </div>
  <div class="footer-grid section-shell">
    <section aria-label="GetIPTVPanel overview" class="footer-intro">
      <a href="/" aria-label="GetIPTVPanel home" class="brand-link">
        <Brand tone="light" />
      </a>
      <p>
        UK-first reseller-panel enquiries and business-planning guidance. Displayed panel prices include no tax, setup fee or separate panel fee.
      </p>
      <div class="footer-contact">
        <a href={whatsAppHref('Hello, I have a GetIPTVPanel enquiry.')} data-event="whatsapp_click" rel="noopener noreferrer">WhatsApp enquiry</a>
      </div>
    </section>

    <nav aria-label="Commercial links">
      <h2>Commercial</h2>
      {commercial.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <nav aria-label="Company links">
      <h2>Company</h2>
      {company.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <nav aria-label="Legal links">
      <h2>Legal</h2>
      {legal.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
  <div class="footer-bottom section-shell">
    <p>&copy; {currentYear} {site.name}. All rights reserved.</p>
    <p>No broadcaster, platform or rights-holder affiliation is claimed.</p>
  </div>
</footer>
