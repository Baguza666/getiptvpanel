---
export interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: string;
}

const { title, description, noindex = false, schema } = Astro.props;
const cleanPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalURL = Astro.site ? new URL(cleanPath, Astro.site) : new URL(cleanPath, 'https://getiptvpanel.com');
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<link rel="manifest" href="/site.webmanifest" />
<link rel="icon" type="image/png" sizes="144x144" href="/iptvfavicon.png?v=2" />

<!-- OpenGraph tags -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content="website" />
<meta property="og:image" content={new URL('/OG-Getiptv.jpg', Astro.site || Astro.url)} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={new URL('/OG-Getiptv.jpg', Astro.site || Astro.url)} />

{noindex && (
  <meta name="robots" content="noindex, nofollow" />
)}

{schema && (
  <script type="application/ld+json" set:html={schema} />
)}
