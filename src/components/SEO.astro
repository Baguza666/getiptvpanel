---
import { site } from '../config/site';

export interface BreadcrumbItem {
  name: string;
  path: string;
}

interface ArticleMeta {
  headline: string;
  dateModified: string;
}

export interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  article?: ArticleMeta;
}

const { title, description, noindex = false, breadcrumbs = [], article } = Astro.props;
const deploymentNoindex = Boolean(import.meta.env.VERCEL_ENV && import.meta.env.VERCEL_ENV !== 'production');
const cleanPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalURL = new URL(cleanPath, site.url);
const ogImage = new URL('/og-card.png', site.url);

const organizationId = new URL('/#organization', site.url).toString();
const websiteId = new URL('/#website', site.url).toString();
const graph: Record<string, unknown>[] = [];

if (cleanPath === '/') {
  graph.push(
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: site.name,
      url: site.url,
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: site.name,
      url: site.url,
      inLanguage: site.language,
      publisher: { '@id': organizationId },
    },
  );
}

if (breadcrumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalURL.toString()}#breadcrumb`,
    itemListElement: breadcrumbs.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: new URL(item.path, site.url).toString(),
    })),
  });
}

if (article) {
  graph.push({
    '@type': 'Article',
    '@id': `${canonicalURL.toString()}#article`,
    headline: article.headline,
    dateModified: article.dateModified,
    mainEntityOfPage: canonicalURL.toString(),
    inLanguage: site.language,
    publisher: { '@type': 'Organization', '@id': organizationId, name: site.name, url: site.url },
  });
}

const shouldRenderSchema = !noindex && !deploymentNoindex && graph.length > 0;
const safeSchema = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<link rel="manifest" href="/site.webmanifest" />
<link rel="icon" type="image/png" href="/iptvfavicon.png" />
<link rel="shortcut icon" href="/iptvfavicon.png" />
<link rel="apple-touch-icon" href="/iptvfavicon.png" />

<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={site.name} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="GetIPTVPanel UK reseller-panel planning and onboarding" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{(noindex || deploymentNoindex) && <meta name="robots" content="noindex, follow" />}
{shouldRenderSchema && <script is:inline type="application/ld+json" set:html={safeSchema}></script>}
