---
import { primaryNavigation } from '../config/site';
import { whatsAppHref } from '../config/contact';
import Brand from './Brand.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const pricingLabel = 'Request Pricing';
const pricingHref = whatsAppHref('Hello, I would like the current reseller pricing and panel terms.');
---

<header class="site-header">
  <div class="nav-shell">
    <a href="/" aria-label="GetIPTVPanel home" class="brand-link">
      <Brand tone="light" compact />
    </a>

    <nav aria-label="Primary navigation" class="desktop-nav">
      {primaryNavigation.map((item) => {
        const isActive = currentPath === item.href || currentPath.startsWith(`${item.href}/`);
        return (
          <a href={item.href} aria-current={isActive ? 'page' : undefined} class="nav-link">
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="nav-actions">
      <a
        href={pricingHref}
        class="button button-primary desktop-cta"
        data-event="whatsapp_click"
        data-placement="header"
      >
        {pricingLabel}
      </a>
      <button
        id="mobile-menu-button"
        class="menu-button"
        type="button"
        aria-label="Open navigation"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
          <path class="menu-icon-open" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="menu-icon-close" stroke-linecap="round" d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile navigation" hidden>
    {primaryNavigation.map((item) => {
      const isActive = currentPath === item.href || currentPath.startsWith(`${item.href}/`);
      return <a href={item.href} aria-current={isActive ? 'page' : undefined} class="mobile-nav-link">{item.label}</a>;
    })}
    <a href={pricingHref} class="button button-primary" data-event="whatsapp_click" data-placement="mobile-menu" rel="noopener noreferrer">
      {pricingLabel}
    </a>
  </nav>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('#mobile-menu-button');
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
  const main = document.querySelector<HTMLElement>('#main-content');
  const footer = document.querySelector<HTMLElement>('.site-footer');
  const stickyAction = document.querySelector<HTMLElement>('.mobile-sticky-cta');
  const consentBanner = document.querySelector<HTMLElement>('.consent-banner');
  const homeLink = document.querySelector<HTMLAnchorElement>('.nav-shell > .brand-link');
  const desktopMedia = window.matchMedia('(min-width: 1100px)');

  const setMenuOpen = (open: boolean) => {
    if (!mobileMenu) return;
    mobileMenu.hidden = !open;
    menuButton?.setAttribute('aria-expanded', String(open));
    menuButton?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    document.body.classList.toggle('menu-open', open);
    if (main) main.inert = open;
    if (footer) footer.inert = open;
    if (stickyAction) stickyAction.inert = open;
    if (consentBanner) consentBanner.inert = open;
    if (open) mobileMenu.querySelector<HTMLAnchorElement>('a')?.focus();
  };

  menuButton?.addEventListener('click', () => {
    setMenuOpen(mobileMenu?.hidden ?? true);
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));

  document.addEventListener('keydown', (event) => {
    if (!mobileMenu || mobileMenu.hidden) return;
    if (event.key === 'Escape') {
      setMenuOpen(false);
      menuButton?.focus();
      return;
    }
    if (event.key !== 'Tab' || !menuButton) return;
    const links = [...mobileMenu.querySelectorAll<HTMLAnchorElement>('a')];
    const focusable = [menuButton, ...links];
    const first = focusable[0];
    const last = focusable.at(-1);
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  desktopMedia.addEventListener('change', (event) => {
    if (!event.matches || mobileMenu?.hidden) return;
    const focusWasInsideMenu = mobileMenu?.contains(document.activeElement);
    setMenuOpen(false);
    if (focusWasInsideMenu) homeLink?.focus();
  });
</script>
