---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { 
  title = "Devenir Revendeur IPTV : Le Panel N°1 pour Lancer Votre Business", 
  description = "GetIPTVPanel: L'infrastructure la plus stable du marché francophone. Technologie Anti-FAI, +20 000 chaînes 4K, panneau de contrôle automatisé.",
  noindex = false
} = Astro.props;

// JSON-LD Schema structured data – Organization only (FAQPage is on index.astro)
const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "GetIPTVPanel",
  "url": "https://getiptvpanel.com/"
};
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} schema={JSON.stringify(schema)} noindex={noindex} />
    
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-V6FRDB4ZD5"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-V6FRDB4ZD5');
    </script>
  </head>
  <body class="bg-obsidian text-white font-sans antialiased overflow-x-hidden min-h-screen flex flex-col">
    <Header />
    <div class="flex-grow">
      <slot />
    </div>
    <Footer />
  </body>
</html>