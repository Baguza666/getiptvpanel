---
import SEO, { type BreadcrumbItem } from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';
import '../config/launch';
import { site } from '../config/site';

interface ArticleMeta {
  headline: string;
  dateModified: string;
}

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  article?: ArticleMeta;
  mobileCta?: { href: string; label: string; event?: string };
}

const { title, description, noindex = false, breadcrumbs = [], article, mobileCta } = Astro.props;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#08130f" />
    <SEO {title} {description} {noindex} {breadcrumbs} {article} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    {mobileCta && (
      <nav class="mobile-sticky-cta" aria-label="Page action">
        <a href={mobileCta.href} class="button button-primary" data-event={mobileCta.event ?? 'reseller_primary_cta_click'} data-placement="mobile-sticky">
          {mobileCta.label}
        </a>
      </nav>
    )}
    <Analytics />
  </body>
</html>
